{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "taomenu-website",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "taomenu-website"
    }
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "NEXT_PUBLIC_WEBSITE_URL": "https://taomenu-website.meathill.workers.dev/",
    "NEXT_PUBLIC_APP_URL": "https://taomenu-app.meathill.workers.dev/"
  }
}
