{
  "name": "@taomenu/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm cf-typegen && node ../../scripts/run-with-wrangler-vars.mjs next build",
    "start": "next start -p 3000",
    "preview": "pnpm cf-typegen && node ../../scripts/run-with-wrangler-vars.mjs opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf-typegen && node ../../scripts/run-with-wrangler-vars.mjs opennextjs-cloudflare build && opennextjs-cloudflare deploy && (pnpm run indexnow || echo 'IndexNow 提交失败（不影响部署）')",
    "indexnow": "node scripts/indexnow-submit.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@opennextjs/cloudflare": "^1.20.17",
    "@phosphor-icons/react": "^2.1.10",
    "@taomenu/shared": "workspace:*",
    "@taomenu/ui": "workspace:*",
    "dayjs": "^1.11.23",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
