{
  "name": "@taomenu/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm cf-typegen && node ../../scripts/run-with-wrangler-vars.mjs next build",
    "start": "next start -p 3000",
    "preview": "pnpm cf-typegen && node ../../scripts/run-with-wrangler-vars.mjs opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf-typegen && node ../../scripts/run-with-wrangler-vars.mjs opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.3",
    "@opennextjs/cloudflare": "^1.20.3",
    "@phosphor-icons/react": "^2.1.10",
    "@taomenu/shared": "workspace:*",
    "@taomenu/ui": "workspace:*",
    "dayjs": "^1.11.23",
    "marked": "^18.0.10",
    "mermaid": "^11.17.2",
    "next": "^16.3.3",
    "next-intl": "^4.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.126.0"
  }
}
