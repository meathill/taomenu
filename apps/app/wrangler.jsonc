{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "taomenu-app",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "taomenu-app"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taomenu",
      // 部署前：wrangler d1 create taomenu → 填入真实 database_id
      "database_id": "a083eccb-3c8f-4bad-a751-b539b449a7a5",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Cloudflare Email Sending：from 域名需先 wrangler email sending enable <domain>
  // local dev 可用 remote:true 走真实发送；无远程时代码回退 console OTP
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  // 菜品图片等媒体。部署前：wrangler r2 bucket create taomenu-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "taomenu-media"
    }
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  // 仅非敏感配置。密钥用 wrangler secret / .dev.vars，不要写进本文件。
  // NEXT_PUBLIC_* 与 BETTER_AUTH_URL 会进入 process.env（nodejs_compat），
  // 代码必须用 process.env 读取，不要 getCloudflareContext().env.NEXT_PUBLIC_*。
  // 无自定义域时填 workers.dev 地址；URL 不要尾斜杠。构建时也需同名 env 才能内联到客户端。
  "vars": {
    "BETTER_AUTH_URL": "https://taomenu-app.meathill.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://taomenu-app.meathill.workers.dev",
    "NEXT_PUBLIC_WEBSITE_URL": "https://taomenu-website.meathill.workers.dev",
    "EMAIL_FROM": "noreply@taomenu.app",
    "EMAIL_FROM_NAME": "TaoMenu",
    "VAPID_SUBJECT": "mailto:ops@taomenu.app"
  }
}
