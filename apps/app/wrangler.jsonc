{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "taomenu-app",
  // 多账号本机 wrangler 非交互时需要；与日志 account 一致
  "account_id": "fdc63eeea83ae8f5234357308b9a638b",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "taomenu-app"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taomenu",
      // 部署前：wrangler d1 create taomenu → 填入真实 database_id
      "database_id": "a083eccb-3c8f-4bad-a751-b539b449a7a5",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Cloudflare Email Sending：from 域名需先 wrangler email sending enable <domain>
  // local dev 可用 remote:true 走真实发送；无远程时代码回退 console OTP
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  // 菜品图片等媒体。部署前：wrangler r2 bucket create taomenu-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "taomenu-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_MENU_QUEUE",
        "queue": "taomenu-ai-menu"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  // 仅非敏感配置。密钥用 wrangler secret / .dev.vars，不要写进本文件。
  // NEXT_PUBLIC_* / BETTER_AUTH_URL 只读 process.env；URL 不要尾斜杠。
  "vars": {
    "BETTER_AUTH_URL": "https://app.menu.dyqr.me",
    "NEXT_PUBLIC_APP_URL": "https://app.menu.dyqr.me",
    "NEXT_PUBLIC_WEBSITE_URL": "https://menu.dyqr.me",
    "EMAIL_FROM": "noreply@dyqr.me",
    "EMAIL_FROM_NAME": "TaoMenu",
    // 空串按未配置处理（升级入口显示未开通）；生产 Price 建好后填入
    "STRIPE_PRO_PRICE_ID": "price_1U2YcYIl4ac8nxMLazjcqCiW",
    "STRIPE_STAFF_SEAT_PRICE_ID": "price_1U1U0FIl4ac8nxMLURDk4j6W",
    "VAPID_SUBJECT": "mailto:ops@dyqr.me",
    // root 管理员邮箱（/admin 入口）。空串按未配置处理：admin 后台对所有人 404。
    // 部署前填入真实邮箱；不是密钥，但同名 secret 会被本文件的值覆盖，别两边都配。
    "ADMIN_EMAIL": ""
  }
}
