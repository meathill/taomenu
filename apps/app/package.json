{
  "name": "@taomenu/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "build": "pnpm cf-typegen && node ../../scripts/run-with-wrangler-vars.mjs next build",
    "start": "next start -p 3001",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply taomenu --local",
    "db:migrate:remote": "wrangler d1 migrations apply taomenu --remote",
    "preview": "pnpm cf-typegen && node ../../scripts/run-with-wrangler-vars.mjs opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf-typegen && node ../../scripts/run-with-wrangler-vars.mjs opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@phosphor-icons/react": "^2.1.10",
    "@pushforge/builder": "^2.0.5",
    "@taomenu/db": "workspace:*",
    "@taomenu/shared": "workspace:*",
    "@taomenu/ui": "workspace:*",
    "better-auth": "^1.7.22",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
